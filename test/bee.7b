# build the simple tzip crate - https://github.com/lovasoa/tinyzip
crate  =tzip
crate main=lib
dep_crates=[]
comp opts=[--cfg,feature="std"]
crate_src=src
test file=test
common =..${~/~}..${~/~}simscript${~/~}comm-crate.7b:file
common_test =..${~/~}..${~/~}simscript${~/~}comm-test.7b:file
crate_dir=..${~/~}..${~/~}crates
doc_dir=..${~/~}..${~/~}docs

version=1.05(014)
set_env(VERSION,version)
test=.${~/~}dirzip${t_ext}

mode=mode:prop
if {
	eq(mode,release) then {
		array(-C,opt-level=3)
		assign(test opts, ~~)
		array(-C,opt-level=3)
		assign(crate opts, ~~)
	}
}

target package {
	dependency {
        target(build)
    }
	dependency{true}
	zip(.${~/~}simzip-${version}.zip,
	-B simzip,
	dirzip${t_ext})
}

include(common);
include(common_test);